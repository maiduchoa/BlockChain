<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Music & Art NFT Marketplace</title>
    <!-- Tailwind CSS cho giao diện đẹp -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/ethers@5.7.2/dist/ethers.umd.min.js"></script>
    <style>
        body { background-color: #0f172a; color: white; font-family: 'Segoe UI', sans-serif; }
        .glass-card { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); }
        .nft-hover:hover { transform: translateY(-8px); transition: all 0.3s ease; }
    </style>
</head>
<body class="min-h-screen pb-20">

    <!-- Header -->
    <nav class="border-b border-white/10 py-6 mb-10 bg-[#0f172a]/90 sticky top-0 z-50">
        <div class="container mx-auto px-6 flex justify-between items-center">
            <h1 class="text-3xl font-extrabold bg-gradient-to-r from-blue-400 to-purple-500 bg-clip-text text-transparent">
                🎵 MusicCopyright
            </h1>
            <button id="connectBtn" class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-2 rounded-full font-bold transition duration-300 shadow-lg shadow-blue-500/20">
                Kết nối MetaMask
            </button>
        </div>
    </nav>

    <div class="container mx-auto px-6">
        <!-- Wallet Info -->
        <p id="walletAddress" class="text-center text-blue-300 mb-8 font-mono opacity-80"></p>

        <!-- Mint Section (Admin Panel) -->
        <div id="adminPanel" class="glass-card rounded-3xl p-8 mb-16 hidden max-w-4xl mx-auto shadow-2xl">
            <h2 class="text-2xl font-bold mb-6 flex items-center">✨ Đăng tác phẩm mới</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm text-gray-400 mb-2">Link Hình ảnh / Nhạc (URL)</label>
                    <input type="text" id="tokenURI" placeholder="https://example.com/song.mp3" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500 text-white">
                </div>
                <div>
                    <label class="block text-sm text-gray-400 mb-2">Giá niêm yết (ETH)</label>
                    <input type="number" id="price" placeholder="Ví dụ: 0.01" step="0.001" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500 text-white">
                </div>
            </div>
            <button onclick="mintItem()" class="w-full mt-6 bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-600 hover:to-indigo-700 text-white font-black py-4 rounded-xl transition-all shadow-xl">
                PHÁT HÀNH LÊN BLOCKCHAIN
            </button>
        </div>

        <!-- Marketplace Grid -->
        <h2 class="text-3xl font-bold mb-10 border-l-4 border-blue-500 pl-4">Khám phá thị trường</h2>
        <div id="marketplace" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-10">
            <!-- NFTs load here -->
        </div>
    </div>

    <!-- Notification Toast -->
    <div id="status" class="fixed bottom-10 right-10 glass-card px-8 py-4 rounded-2xl hidden shadow-2xl border-blue-500/50">
        <p id="statusText" class="font-bold text-blue-400"></p>
    </div>

    <script>
        const contractAddress = "0xe031f7948404a6e3a4ba27325d92bd811d35aA15";
        const abi = [
            "function mintArtwork(string tokenURI, uint256 price) public",
            "function buyArtwork(uint256 tokenId) public payable",
            "function cancelSale(uint256 tokenId) public",
            "function nextTokenId() public view returns (uint256)",
            "function artworks(uint256) public view returns (address creator, uint256 price, bool isForSale)",
            "function ownerOf(uint256 tokenId) public view returns (address)",
            "function tokenURI(uint256 tokenId) public view returns (string)"
        ];

        let signer, contract;

        function notify(msg) {
            const el = document.getElementById("status");
            document.getElementById("statusText").innerText = msg;
            el.classList.remove("hidden");
            setTimeout(() => el.classList.add("hidden"), 5000);
        }

        async function connect() {
            if (window.ethereum) {
                const provider = new ethers.providers.Web3Provider(window.ethereum);
                await provider.send("eth_requestAccounts", []);
                signer = provider.getSigner();
                contract = new ethers.Contract(contractAddress, abi, signer);
                
                const addr = await signer.getAddress();
                document.getElementById("walletAddress").innerText = "Đã kết nối: " + addr;
                document.getElementById("connectBtn").innerText = addr.substring(0,6) + "..." + addr.substring(38);
                document.getElementById("adminPanel").classList.remove("hidden");
                loadMarketplace();
                notify("Ví đã sẵn sàng!");
            }
        }

        async function mintItem() {
            const uri = document.getElementById("tokenURI").value;
            const priceVal = document.getElementById("price").value;
            if(!uri || !priceVal) return alert("Vui lòng nhập đủ thông tin!");
            
            try {
                notify("Đang chờ xác nhận giao dịch...");
                const price = ethers.utils.parseEther(priceVal);
                const tx = await contract.mintArtwork(uri, price);
                await tx.wait();
                notify("Đăng tải thành công!");
                loadMarketplace();
            } catch (err) { notify("Lỗi: Giao dịch bị từ chối."); }
        }

        async function loadMarketplace() {
            const total = await contract.nextTokenId();
            const container = document.getElementById("marketplace");
            container.innerHTML = "";
            const userAddr = (await signer.getAddress()).toLowerCase();

            for (let i = 0; i < total; i++) {
                const art = await contract.artworks(i);
                if (!art.isForSale) continue;

                const owner = (await contract.ownerOf(i)).toLowerCase();
                const uri = await contract.tokenURI(i);
                const isMusic = uri.includes(".mp3") || uri.includes(".wav");

                const card = document.createElement("div");
                card.className = "glass-card rounded-3xl p-4 nft-hover transition-all duration-300";
                card.innerHTML = `
                    <div class="h-48 w-full mb-4 rounded-2xl overflow-hidden bg-black/40 flex items-center justify-center">
                        ${isMusic ? 
                            `<div class="text-center"><span class="text-5xl">🎵</span><br><audio controls class="mt-2 w-44"><source src="${uri}"></audio></div>` :
                            `<img src="${uri}" class="h-full w-full object-cover" onerror="this.src='https://placehold.co/600x400/2563eb/FFF?text=Art+NFT'">`
                        }
                    </div>
                    <div class="flex justify-between items-center mb-4">
                        <span class="text-xs bg-white/10 px-3 py-1 rounded-full text-gray-400">ID: #${i}</span>
                        <span class="text-blue-400 font-bold font-mono">${ethers.utils.formatEther(art.price)} ETH</span>
                    </div>
                    ${owner === userAddr ? 
                        `<button onclick="cancelSale(${i})" class="w-full bg-red-500/20 hover:bg-red-500 text-red-500 hover:text-white font-bold py-3 rounded-xl border border-red-500/50 transition">GỠ BỎ</button>` : 
                        `<button onclick="buyItem(${i}, '${ethers.utils.formatEther(art.price)}')" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-xl shadow-lg shadow-blue-500/30 transition">MUA NGAY</button>`
                    }
                `;
                container.appendChild(card);
            }
        }

        async function buyItem(id, price) {
            try {
                notify("Đang thanh toán...");
                const tx = await contract.buyArtwork(id, { value: ethers.utils.parseEther(price) });
                await tx.wait();
                notify("Sở hữu thành công!");
                loadMarketplace();
            } catch (err) { notify("Lỗi thanh toán!"); }
        }

        async function cancelSale(id) {
            try {
                const tx = await contract.cancelSale(id);
                await tx.wait();
                notify("Đã gỡ bài hát!");
                loadMarketplace();
            } catch (err) { notify("Lỗi thao tác!"); }
        }

        document.getElementById("connectBtn").onclick = connect;
    </script>
</body>
</html>